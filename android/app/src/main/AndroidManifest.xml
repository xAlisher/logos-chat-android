<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR intro-bundle scanner (#15). Camera is optional: the paste-bundle
         fallback is always reachable, so no required uses-feature. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Valid-scan haptic (RN Vibration API throws SecurityException without this) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ChatService (#25): the node keeps receiving with the app backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MeshCore radio over BLE (#166). Android 12+: SCAN + CONNECT (neverForLocation
         since we only talk to our paired radio, not derive location). Legacy ≤30:
         BLUETOOTH/ADMIN + FINE_LOCATION (required for a BLE scan pre-31). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE-mesh transport (#133): the peripheral role advertises our Logos-mesh
         service so nearby app peers can discover us. Android 12+ only. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- #204 location share (all SDKs) — also covers the pre-31 BLE-scan need. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- #205 voice notes: record audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Android 11+ (API 30+) package visibility: without this, resolveActivity()
         for the camera-capture intent returns null even when a camera app exists,
         so ImagePickerModule falsely reports "no camera app available". Declare the
         capture + gallery intents we launch so the system lets us see their handlers. -->
    <queries>
      <intent>
        <action android:name="android.media.action.IMAGE_CAPTURE" />
      </intent>
      <intent>
        <action android:name="android.intent.action.GET_CONTENT" />
        <data android:mimeType="image/*" />
      </intent>
    </queries>

    <!-- #267: enableOnBackInvokedCallback is kept FALSE. Opting into the predictive-
         back API made back EXIT the app from nested screens instead of popping —
         RN back handling still uses the legacy onBackPressed path, so with the new
         callback on, the OS default (finish activity) fired. Off = back/edge-swipe
         correctly pops the navigation stack. -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:largeHeap="true"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:enableOnBackInvokedCallback="false"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:screenOrientation="portrait"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- #38: shares the app-DB JSON backup written to cacheDir/exports via a
           content:// URI so the share sheet's target can read it without a
           storage permission. Paths declared in res/xml/file_paths.xml. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

      <!-- Owns the node + DB so messages keep arriving (and persisting) while the
           app is backgrounded or swiped away; START_STICKY brings it back. -->
      <service
        android:name=".ChatService"
        android:foregroundServiceType="dataSync"
        android:exported="false" />
    </application>
</manifest>
